{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node", "react", "react-dom"],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true
  },
  "include": ["src/remotion/**/*.ts", "src/remotion/**/*.tsx", "src/remotion/**/*.js"]
}
